/comparative_methods/**/*.ckpt
/comparative_methods/**/*.pt
/comparative_methods/**/*.pth
/comparative_methods/**/*.safetensors

# Shared campaign evidence is local by default. Retain only the reviewed,
# explicitly listed compact contract; tracked historical files stay tracked.
/comparative_methods/evidence/*
!/comparative_methods/evidence/joint_protected_unlock_candidate_v2.json
!/comparative_methods/evidence/protected_campaign/
!/comparative_methods/evidence/protected_campaign/**

# Keep experiment outputs private until an explicit public release is prepared.
# Protocol source and compact result summaries remain tracked; run-specific
# campaign controls, payloads, shadow predictions, lane benchmarks, unblinding
# records, and aggregates stay local.
/comparative_methods/runs/
/comparative_methods/evidence/protected_campaign/shadow_*/
/comparative_methods/evidence/protected_campaign/lane_manifest_v*.json
/comparative_methods/evidence/protected_campaign/unblind_manifest_v*.json
/comparative_methods/evidence/protected_campaign/*aggregate*
/comparative_methods/evidence/protected_campaign/**/*.npz
# Run-specific protected-campaign control records stay local. Their immutable
# identities are retained in the tracked result report rather than the payloads.
/comparative_methods/evidence/protected_campaign/authorization_template_v1.json
/comparative_methods/evidence/protected_campaign/joint_release_candidate_v1.json
/comparative_methods/evidence/protected_campaign/orr_preflight_v1.json

# Deterministic public/protected fold manifests are regenerated by
# build_split_registry.py; keep the generator, not thousands of JSON outputs.
/comparative_methods/STA-Net-PyTorch/split_registry/

