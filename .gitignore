# temp log directory    
/logs

# Comparison source and contracts are tracked by default. Ignore only local
# upstream mirrors, binaries, generated runs, and protected payloads; adding a
# method must not require another source-code allowlist entry.
/comparative_methods/STA-Net/
/comparative_methods/EFRM-A-Multimodal-EEG-fNIRS-Representation-learning-Model/
/comparative_methods/*/upstream/
/comparative_methods/*/checkpoints/*
